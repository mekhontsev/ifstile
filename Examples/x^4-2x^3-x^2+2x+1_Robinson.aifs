@G
$a=h
$n=2a.b-a.b
$dim=4
$subspace=s 0
s=$companion([1,-1,1,-1])
r=[1,1,0,0,0,-1,0,0,0,1,0,-1,0,-1,-1,0]
g=s-s^4
&Q=$semigroup([s,r])*$vector(0)
h0=Q
h1=Q
h2=Q
h3=Q
h4=Q
A0=g^-1*(h0*A0|h1*A0|h2*A1)
A1=g^-1*(h3*A0|h4*A1)

