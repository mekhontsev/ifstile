@@version 3

@G
$a=h
$n=Base
$dim=2
$subspace=g 0
g=$companion([2,0])
r=[1,0,0,-1]
&R=$semigroup([-1,r])
&T=R*$vector(0)
h0=R
h1=T
A=g^-1*(h0|h1)*A

@:G
$n=1.000000_8
h0=r*-1
h1=r*[1,1]

@G2:G
$a=h
$n=a.2a2
h0=R
h1=T
h2=T
A=(g^-1*h0|g^-2*h1|g^-2*h2)*A

