@PT

#http://larryriddle.agnesscott.org/ifs/siertri/sierpedal.htm
#http://www.richardhitt.com/research/hittzhang.pdf


$a=h
$dim=2

#Angle
A=$number($real(0,90))
#Ballance
k=$number($real(0,1))
B=90-A+k*A
C=180-A-B

r=asin(1)/90

a=A*r
b=B*r
c=C*r

u1=cos(b)^2
v1=cos(b)*sin(b)

u2=cos(c)^2
v2=-cos(c)*sin(c)

u3=-cos(a)*cos(c-b)
v3=cos(a)*sin(c-b)

P=[sin(c)*sin(a), cos(c)*sin(a)]

f1=1*[u1,v1,v1,-u1]
f2=P*[u2,v2,v2,-u2]
f3=P*[u3,v3,v3,-u3]

#Triangle
T=f1*T|f2*T|f3*T


@:PT
$n=Pedal Triangle
$root=T
A=70
k=0.5714285714285714


