@G4
$a=h
$n=G4
$dim=2
s=$companion([1,0])
r=$companion([-1,0])
&R=$semigroup([s,r])
&T=R*$vector(0)
h0=T
h1=T
h2=T
h3=T
h4=T
h5=T
A=3^-1*(2*h0|h1|h2|h3|h4|h5)*A

