@@version 3

@G
$a=h
$n=2a
$dim=2
g=[1,-1,1,1]
s=[0,-1,1,0]
r=[-1,0,0,1]
&R=$semigroup([s,r])
&T=R*$vector(0)
h0=R
h1=T
A=g^-1*(h0|h1)*A

@G2:G
$a=h
$n=a.2a2
h2=T
A=(g^-1*h0|g^-2*h1|g^-2*h2)*A

@G3:G2
$a=h
$n=a.b-b.a
h3=T
A=g^-1*(h0*A|h1*B)
B=g^-1*(h2*A|h3*B)

@G4:G3
$a=h
$n=a.b2-2a.b
h4=T
A=g^-1*h0*A|g^-2*h1*B
B=g^-1*h2*A|g^-1*h3*A|g^-1*h4*B

@:G
$n=Heighway Dragon
h0=s^2
h1=s*[1,-1]

@:G
$n=Twin Dragon
h0=1
h1=s^2*[-2,0]

@:G
$n=Levy C Curve
