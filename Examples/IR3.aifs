@@version 3


@IR3
$a=h
$dim=2

s=$number($real(0,1))

r=(1+s^2+s^4)^(-1/2)

a=s*(1+r^2*s^2)/(1+r^2*s^6)
b=r*(1-s^4)/(1+r^2*s^6)

m=[b,-a,-a,-b]


f1=[s^5*a*r^2,s^3*r*(1+s^2*b*r)]*m
f2=[s^2*r^2*(1+s^2),0]*[0,-1,1,0]
f3=[s*a,s*(s^2*r+b)]*m

S = (f1*s^2|f2*s|f3)*r*S

@:IR3
$n=irrep3
s=0.7373527057603277 #s^6+s^4+s^2-1=0