@@version 3

@G
$n=G
$dim=2
$a=h
s=$companion([1,0])
r=$companion([-1,0])
&R=$semigroup([s,r])
&T=R*$vector(0)
h1=T
h2=T
h3=T
h4=T
h5=T
h6=T
h7=T
h8=T
A=5^-1*(3*h1|2*h2|2*h3|2*h4|h5|h6|h7|h8)*A

@:G
$n=Square
h1=[0,0]
h2=[3,0]
h3=[0,3]
h4=[3,3]
h5=[8,4]
h6=[6,4]
h7=[4,6]
h8=[4,8]

