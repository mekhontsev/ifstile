h1=T
h2=T
h3=T
h4=T
h5=T
h6=T
h7=T
h8=T
A=g^-1*(h0*A|h1*C)
B=g^-1*(h2*A|h3*A|h4*B)
C=g^-1*(h5*A|h6*A|h7*A|h8*B)

