r=$companion([-1,0])
&R=$semigroup([s,r])
&T=R*$vector(0)
h0=T
h1=T
h2=T
h3=T
h4=T
h5=T
h6=T
h7=T
A=4^-1*(3*h0|h1|h2|h3|h4|h5|h6|h7)*A

