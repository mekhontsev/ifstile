@G
$a=h
$n=2a.b-a.b
$dim=4
$subspace=x 0
x=$companion([1,0,3,0])
r=$companion([-1],[1],[-1],[1])
s=x^3+2*x
g=s*x
&T=$semigroup([s,r])*$vector(0)
h0=T
h1=T
h2=T
h3=T
h4=T
A0=g^-1*(h0*A0|h1*A0|h2*A1)
A1=g^-1*(h3*A0|h4*A1)

@:G
$n=1.000000_38
h0=s*r*[0,1,-1,0]
h1=s^2*[-1,0,-1,0]
h2=s^3*[0,0,0,0]
h3=r*s^2*[-1,2,-1,1]
h4=s*r*[1,0,0,0]

@:G
$n=1.000000_152
h0=r*s*[0,0,-1,0]
h1=s^2*[0,0,1,0]
h2=s^3*[0,0,0,1]
h3=r*[0,0,0,0]
h4=s*[0,-1,0,0]

@:G
$a=h
$n=1.000000_61
h0=s*r*[0,1,0,0]
h1=1*[0,-1,0,0]
h2=s*r*[-1,0,-1,0]
h3=s^2*[-1,0,-1,0]
h4=r*s*[0,-1,0,0]

@:G
$n=1.000000_73
h0=s*r*[0,1,0,0]
h1=r*s*[0,-1,-1,0]
h2=r*s^2*[-1,0,-1,0]
h3=r*s^2*[-1,0,-1,0]
h4=1*[1,0,0,0]

@:G
$n=1.000000_110
h0=r*s*[0,1,0,0]
h1=s^3*[0,-1,0,0]
h2=1*[-1,0,-1,0]
h3=1*[-1,0,-1,0]
h4=r*s^2*[1,0,1,0]

@:G
$n=1.000000_91
h0=r*s*[0,0,-1,0]
h1=s*r*[0,0,1,0]
h2=r*[0,0,0,1]
h3=r*[0,0,0,0]
h4=s^2*[0,-1,0,0]

