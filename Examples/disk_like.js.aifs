//Disk-Like tiles with n pieces and a very high boundary dimension (and simple neighbour graph)
//dim boundary = 2*log(x)/log(n) where x^4-(n-1)*x^3-2*x^2-(n-1)*(n-4)*x+n*(n-2)=0

export const $aifs=
{
	$dim: 2,
	$id: "dl",
	$subspace : ["c", 0, 1],
	A: ["g^-1","u", "A", "*"],
	u: ["h","|"],
	//r:"$diagonal([1,-1])",
	v: "[-n,0]",
	n: "$number($integer(2,20))",//number of maps
	x: "1/(n-1)",
	c : "$companion(v)",
	g : "c",
	h: "[n-x, 2-x]*-1",

	//even higher boundary dimension, but not disk-like and has reflections
	//g: "-c",
	//h: "[-x,-1+x]*-1",
	
	$init: function()
	{
		//console.log("$init called, this=", this);
		let n=this.n;
		let u=["h"];
		for(let i=1; i<n; ++i){
			u[i]=[i-1,0]
		}
		u.push("|");
		this.u = u;
	}
};




