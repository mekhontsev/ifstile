@scale3d
$a=h
kx=1
ky=1
kz=1
ret=[kx,0,0,0,ky,0,0,0,kz]

@rotate3d
$a=h
q=[0,0,1]
ang=0
k1=1
k2=1
arad=ang*asin(1)/90
sn=k2*sin(arad)
cs=k2*cos(arad)
qn=(q[0]*q[0]+q[1]*q[1]+q[2]*q[2])^(1/2)
x=q[0]/qn
y=q[1]/qn
z=q[2]/qn
a=[(x*x),(x*y),(x*z),(y*x),(y*y),(y*z),(z*x),(z*y),(z*z)]
b=[0,z,-y,-z,0,x,y,-x,0]
ret=k1*a-(b*sn)-((a-1)*cs)


@
$dim=3
$n=3D V-Set
$camera=[[-4,2,-1],[0,0,0],[0.14,-0.07,-0.63],30]
$palette=[[1,0.5,0,1],[0,0.5,0,1]]

t1 = [-1,-1,0]
t2 = [ 1,-1,0]
t3 = [ 1, 1,0]
t4 = [-1, 1,0]

f1 = t1*1/2*t1^-1
f2 = t2*1/2*t2^-1
f3 = t3*1/2*t3^-1
f4 = t4*1/2*t4^-1

s=rotate3d([0,0,-1],90)

# two maps for the segment in the 2nd set
t5=[-1/2,-1/2,-1/2]
t6=[0,0,-1]

f5 = t5*1/2*t5^-1
f6 = t6*1/2*t6^-1

S2 = $style(0)*(f1|f2|f3|f4)*S2 | $style(1)*(1|s|s^2|s^3)*S1
S1 = (f5|f6)*S1


@
$dim=3
$n=Pipe Tree
$camera=[[-5,-5,0],[0,0,1.5],[0,0,1],30]
$palette=[[1,0.5,0,1],[0,0.5,0,1]]

a = .1

t1 = [ a,-a,0]
t2 = [-a,-a,0]
t3 = [ a,-a,1]
t4 = [-a,-a,1]

m1=[1/2,0,0, 1/4,1/4,0, 0,0,1/2]
m2=[1/2,0,0,-1/4,1/4,0, 0,0,1/2]

f1 = t1*m1*t1^-1
f2 = t2*m2*t2^-1
f3 = t3*m1*t3^-1
f4 = t4*m2*t4^-1

r=rotate3d([0,0,1], 120)

g1 = [0,0,1]*rotate3d([1,0,0],45)*2^(-1/2)
g2 = r*g1*r^-1
g3 = r^-1*g1*r

m=g1|g2|g3

tree=$style(0)*trunk| $style(1)*crown

wall = (f1|f2|f3|f4)*wall

s=rotate3d([0,0,1],90)

cil = (1|s|s^2|s^3)*wall
trunk=(1|m*(1|m*(1|m*(1|m*(1|m*(1|m*(1|m*(1|m*(1|m*(1|m))))))))))*cil
crown=m^11*cil


#############################################################
@
$dim=3
$n=Chinese Lamp
$camera=[[-0.1,0.55,-3],[0.5,-0.5,0.62],[0.17,0.74,0.15],30]

#from: IFS Builder 3D


#a set consisting of 5 attractors of SnowBall
ChineseLamp = (
	1 |
	[1,-1, 0]*rotate3d([0,0,1],180) | 
	[0, 0, 1]*rotate3d([1,0,0], 90) |
	[0,-1, 0]*rotate3d([0,0,1], 90) |
	[1, 0, 0]*rotate3d([0,0,1],-90) 
)*SnowBall

#define the Snowball surface Self-Similar IFS
# see also: D.Meyer,"Quasisymmetric Embedding of Self Similar Surfaces and 
#     Origami with Rational Maps", Ann. Acad. Sci. Fenn. Math, V.27,2002,pp.461-484
#     Annales Academia Scientarum Fennicae Mathematica
SnowBall=(
	[  0,   0,   0] |
	[1/3,   0,   0] |
	[2/3,   0,   0] |
	[  0,   0, 1/3] |
	[2/3,   0, 1/3] |
	[  0,   0, 2/3] |
	[1/3,   0, 2/3] |
	[2/3,   0, 2/3] |	
	[1/3, 1/3, 1/3] |
	[1/3,   0, 1/3]*rotate3d([0,0,1], 90) |
	[2/3, 1/3, 1/3]*rotate3d([0,0,1],-90) |	
	[1/3,   0, 1/3]*rotate3d([1,0,0],-90) |
	[1/3, 1/3, 2/3]*rotate3d([1,0,0], 90)
)*(1/3)*SnowBall


@DSquareBase
$dim=3
$a=h
a=$number($real(0,180))
S=(1/3)*(
	[-2, 0,-2] |
	[ 0, 0,-2] |
	[ 2, 0,-2] |
	[-2, 0, 0] |
	[ 2, 0, 0] |
	[-2, 0, 2] |
	[ 0, 0, 2] |
	[ 2, 0, 2] |
	rotate3d([0,0,1],a)
)*S

@:DSquareBase
$n=Distorted Square
a=110

@CrossBase
$dim=3
$a=h
k=$number($real(0,1))
s = (1+k)/2
r = (1-k)/2
A = (k|r*[s,0,0]|r*[0, s,0]|r*[0,0, s]|r*[-s,0,0]|r*[0,-s,0]|r*[0,0,-s])*A
		
@:CrossBase
$n=Cross
k=1/3

@
$dim=3
$camera=[[-0.98,2.74,-4.16],[0,0,0],[0.31,-0.45,-0.37],30]
$n=Octahedral
S = (1/3)*([2,2,0]|[0,2,0]|[-2,2,0]|[2,0,0]|[-2,0,0]|[2,-2,0]|[0,-2,0]|[-2,-2,0]|[0,0,2]|[0,0,-2])*S