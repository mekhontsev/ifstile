//AIFS_IGNORE_BEGIN

export const $info=`
**Algebraic self-affine curves.**
`

let params = [
["N", [7n, 2n, 20n], "Number of maps"],
["D", [2n, 1n, 8n], "Max algebraic dimension"],
["P", [0n, 0n, 1n], "Palindromic"],
["M", [3n, 1n, 10n], "Maximum coefficient of a polynomial"],
["E", [3n, 1n, 10n], "Maximum used order of the group generator: s^E, s^-E"],
["R", [1n, 1n, 10n], "Max numerator (for irrational search only)"],
["Q", [1n, 1n, 10n], "Max denominator (for irrational search only)"],
]

function create()
{

	const N=this[0];
	const D=this[1];
	const P=this[2];
	const M=this[3];
	const E=this[4];
	const R=this[5];
	const Q=this[6];

	let dim=D;

	let c=[];
	let pn=dim;
	if (P==1){
		if (dim%2!=0){
			dim=dim-1;
		}
		pn=dim/2;
		c.push(1);
		for(let i=1;i<dim;++i){
			if (i<=pn){
				c.push(`p[${i-1}]/a`);
			}else{
				c.push(`p[${dim-i-1}]/a`);
			}
		}
	}else{
		for(let i=0;i<dim;++i){
			c.push(`p[${i}]/a`);
		}
	}

	let v=[1]
	for(let i=1;i<dim;++i){
		v.push(0)
	}

	let max_j = (P==0 && dim>2) ? 1:3

	let B=
	{
		$id: `G${N}_${dim}_${P}`,
		$dim: dim,
		$subspace : `[s,i]`,
		c: c,
		s: "$companion(c)",
		x: "$exchange()",
		v: v,
		w: `x*s^${dim-1}`,
		xj: "[1,(v*-1),w,(w*v*-1)]",
		p: `$vector(${pn},$integer(${-M},${M}))`,
		k: `$vector(${N},$integer(${-E},${E}))`,
		r: `$vector(${N},$integer(${-R},${R-1}))`,
		q: `$vector(${N},$integer(1,${Q}))`,
		j: `$vector(${N},$integer(0,${max_j}))`,
		a: `$number($integer(1,${M}))`,
		i: `$number($integer(0,${dim-1}))`,
		u: "v*0",
		t0: 1,
	}


	for (let i=0;i<N;++i){
		B["s"+i]=`(r[${i}]+if(r[${i}]+1,1,0))/q[i]*s^k[${i}]`;	
	}

	for (let i=1;i<N;++i){	
		B["t"+i]=`(s${i-1}*u+1)*t${i-1}`;
	}

	let sum="";
	let uni="";
	for (let i=0;i<N;++i){
		B["h"+i]=`t${i}*s${i}*xj[j[${i}]]`;
		
		if(i>0){
			sum=sum+"+";
			uni=uni+"|";
		}
		
		sum=sum+"s"+i;
		uni=uni+"h"+i;
	}

	B.g=sum;
	B.A="g^-1*(" + uni + ")*A";

	return B
}

export const $constructor=[create, params];

//AIFS_IGNORE_END