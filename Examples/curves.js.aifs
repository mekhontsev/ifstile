//AIFS_IGNORE_BEGIN

export const $info = `
**Algebraic self-affine curves.**
`

	let params = [
		["Maps in the trunk",
			[7n, 2, 20]],
		["Branch locations (one map per branch)",
			[0n, [0n, 0, 100]]],
		["Max algebraic dimension",
			[2n, 1, 8]],
		["Palindromic",
			[0n, 0, 1]],
		["Maximum coefficient of a polynomial",
			[3n, 1, 10]],
		["Maximum used order of the group generator: s^E, s^-E",
			[3n, 1, 15]],
		["Max numerator (for irrational search only)",
			[1n, 1, 10]],
		["Max denominator (for irrational search only)",
			[1n, 1, 10]],
	]

function create() {

	const [N, B, D, P, C, E, R, Q] = this

		let dim = D;

	let c = [];
	let pn = dim;
	if (P == 1) {
		if (dim % 2 != 0) {
			dim = dim - 1;
		}
		pn = dim / 2;
		c.push(1);
		for (let i = 1; i < dim; ++i) {
			if (i <= pn) {
				c.push(`p[${i - 1}]/a`);
			} else {
				c.push(`p[${dim - i - 1}]/a`);
			}
		}
	} else {
		for (let i = 0; i < dim; ++i) {
			c.push(`p[${i}]/a`);
		}
	}

	let v = [1]
	for (let i = 1; i < dim; ++i) {
		v.push(0)
	}

	let max_j = (P == 0 && dim > 2) ? 1 : 3

	let nB = B.length; //number of branches
	let idB = `B${nB}_`;
	for (let i = 0; i < nB; ++i) {
		idB += `${B[i]}_`
	}

	let M = N + nB; //total number of maps

	let T = {
		$id: `G${N}_${idB}${dim}_${P}`,
		$dim: dim,
		$subspace: "[s,i]",
		c: c,
		s: "$companion(c)",
		x: "$exchange()",
		v: v,
		w: `x*s^${dim - 1}`,
		xj: "[1,(v*-1),w,(w*v*-1)]",
		p: `$vector(${pn},$integer(${ - C},${C}))`,
		k: `$vector(${M},$integer(${ - E},${E}))`,
		r: `$vector(${M},$integer(${ - R},${R - 1}))`,
		q: `$vector(${M},$integer(1,${Q}))`,
		j: `$vector(${M},$integer(0,${max_j}))`,
		a: `$number($integer(1,${C}))`,
		i: `$number($integer(0,${dim - 1}))`,
		u: "v*0",
		t0: 1,
	}

	for (let i = 0; i < M; ++i) {
		T["s" + i] = `(r[${i}]+if(r[${i}]+1,1,0))/q[${i}]*s^k[${i}]`;
	}

	for (let i = 1; i < M; ++i) {
		if (i < N) {
			T["t" + i] = `(s${i - 1}*u+1)*t${i - 1}`;
		} else {
			let base = B[i - N] % (i + 1);
			if (base == 0) {
				T["t" + i] = `t0`;
			} else {
				T["t" + i] = `(s${base - 1}*u+1)*t${base - 1}`;
			}
		}
	}

	let uni = "";
	for (let i = 0; i < M; ++i) {
		T["h" + i] = `t${i}*s${i}*xj[j[${i}]]`;

		if (i > 0) {
			uni = uni + "|";
		}
		uni = uni + "h" + i;
	}

	let sum = "";
	for (let i = 0; i < N; ++i) {
		if (i > 0) {
			sum = sum + "+";
		}
		sum = sum + "s" + i;
	}
	T.g = sum;

	T.A = "g^-1*(" + uni + ")*A";

	return T
}

export const $constructor = [create, params];

//AIFS_IGNORE_END
