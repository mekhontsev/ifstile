export const $info=`
**Algebraic self-affine curves.**

N: Number of maps: 2,3,...
D: Max algebraic dimension
M: Max coefficent of polynmial
E: Maximal used order of element: s^E, s^-E
P: 1 - palindromic generator, 0 - any
R: Max numerator 1,2,... (for irrational search only)
Q: Max denominator		 (for irrational search only)	

Before changing N,D,P parameters, remove all items from the IFS list!

`
//////////////////////////////////////
const N=7;

const D=2;
const M=3;
const E=3;
const P=0;

const R=1;
const Q=1;
//////////////////////////////////////

let dim=D;

let c=[];
let pn=dim;
if (P==1){
	if (dim%2!=0){
		dim=dim-1;
	}
	pn=dim/2;
	
	c.push(1);
	for(let i=1;i<dim;++i){
		if (i<=pn){
			c.push(`p[${i-1}]/a`);
		}else{
			c.push(`p[${dim-i-1}]/a`);
		}
	}
	
}else{
	for(let i=0;i<dim;++i){
		c.push(`p[${i}]/a`);
	}
}

let v=[1]
for(let i=1;i<dim;++i){
	v.push(0)
}

let max_j = (P==0 && dim>2) ? 1:3

let B=
{
	$id: `G${N}_${dim}_${P}`,
	$a: "h",
	$dim: dim,
	$subspace : `[s,i]`,
	c: c,
	s: "$companion(c)",
	x: "$exchange()",
	v: v,
	w: `x*s^${dim-1}`,
	xj: "[1,(v*-1),w,(w*v*-1)]",
	p: `$vector(${pn},$integer(${-M},${M}))`,
	k: `$vector(${N},$integer(${-E},${E}))`,
	r: `$vector(${N},$integer(${-R},${R-1}))`,
	q: `$vector(${N},$integer(1,${Q}))`,
	j: `$vector(${N},$integer(0,${max_j}))`,
	a: `$number($integer(1,${M}))`,
	i: `$number($integer(0,${dim-1}))`,
	u: "v*0",
	t0: 1,
}


for (let i=0;i<N;++i){
	B["s"+i]=`(r[${i}]+if(r[${i}]+1,1,0))/q[i]*s^k[${i}]`;	
}

for (let i=1;i<N;++i){	
	B["t"+i]=`(s${i-1}*u+1)*t${i-1}`;
}

let sum="";
let uni="";
for (let i=0;i<N;++i){
	B["h"+i]=`t${i}*s${i}*xj[j[${i}]]`;
	
	if(i>0){
		sum=sum+"+";
		uni=uni+"|";
	}
	
	sum=sum+"s"+i;
	uni=uni+"h"+i;
}

B.g=sum;
B.A="g^-1*(" + uni + ")*A";

export const $aifs=B

@@


