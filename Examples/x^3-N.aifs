@G3
$a=h
$n=x^3-3
$dim=3
$subspace=g 0 1
g=$companion([-3,0,0])
&R=$semigroup([-1])
&T=R*$vector(0)
h0=T
h1=T
h2=T
A=g^-1*(h0|h1|h2)*A

@G4:G3
$a=h
$n=x^3-4
g=$companion([-4,0,0])
h3=T
A=g^-1*(h0|h1|h2|h3)*A

@G5:G4
