$n=x^3-5
g=$companion([-5,0,0])
h4=T
A=g^-1*(h0|h1|h2|h3|h4)*A

@G6:G5
$a=h
$n=x^3-6
g=$companion([-6,0,0])
h5=R
A=g^-1*(h0|h1|h2|h3|h4|h5)*A

