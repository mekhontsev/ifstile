@@version 3

@G2
$a=h
$n=2a
$dim=3
$subspace=g 0 1
g=$companion([-2,0,0])
&R=$semigroup([-1])
&T=R*$vector(0)
h0=T
h1=T
A=g^-1*(h0|h1)*A

@G21:G2
$a=h
$n=a.2a2
h2=T
A=(g^-1*h0|g^-2*h1|g^-2*h2)*A

@G22:G21
$a=h
$n=a.b-a.b
h3=T
A=g^-1*(h0*A|h1*B)
B=g^-1*(h2*A|h3*B)

@:G2
$n=2.000000_26
h0=-1*[0,0,-2]
h1=-1*[-1,0,1]

