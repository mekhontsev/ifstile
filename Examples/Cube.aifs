@G
$n=Base
$dim=3
a=[-1,0,0,0,-1,0,0,0,-1]
b=[0,-1,0,1,0,0,0,0,1]
c=[1,0,0,0,0,-1,0,1,0]
d=[0,-1,0,0,0,-1,1,0,0]
&T=$semigroup([a,b,c,d])*$vector(0)
h0=T
h1=T
h2=T
h3=T
h4=T
h5=T
h6=T
h7=T
A=2^-1*(h0|h1|h2|h3|h4|h5|h6|h7)*A

@:G
$n=Cube
h0=[0,0,0]
h1=[0,0,1]
h2=[0,1,0]
h3=[0,1,1]
h4=[1,0,0]
h5=[1,0,1]
h6=[1,1,0]
h7=[1,1,1]

@:G
$n=2.000000_30
h0=[0,0,0]
h1=[0,0,1]
h2=[0,1,0]
h3=[0,1,1]
h4=1*[-1,0,0]
h5=[1,0,1]
h6=[1,1,0]
h7=[1,1,1]

@:G
$n=2.388484_34
h0=[0,0,0]
h1=1*[0,0,-1]
h2=[0,1,0]
h3=[0,1,1]
h4=1*[-1,0,0]
h5=[1,0,1]
h6=[1,1,0]
h7=[1,1,1]

@:G
$n=2.453023_36
h0=b^2*a*d^2*b*[0,0,0]
h1=[0,0,1]
h2=[0,1,0]
h3=b^2*a*d^2*b*[1,1,0]
h4=b^2*a*d^2*b*[1,0,0]
h5=[1,0,1]
h6=b^2*a*d^2*b*[0,1,-1]
h7=[1,1,1]

@:G
$n=2.610711_36
h0=b^2*a*d^2*b*[0,0,0]
h1=[0,0,1]
h2=b^2*a*d^2*b*[0,1,0]
h3=b^2*a*d^2*b*[1,1,0]
h4=b^2*a*d^2*b*[1,0,0]
h5=[1,0,1]
h6=b^2*a*d^2*b*[0,1,-1]
h7=[1,1,1]

@:G
$n=2.000000_38
h0=[0,0,0]
h1=1*[0,0,1]
h2=[0,1,0]
h3=[0,1,1]
h4=c*d*a*[1,0,0]
h5=c*d*a*[1,0,-1]
h6=[1,1,0]
h7=[1,1,1]

@:G
$n=2.436752_40
h0=[0,0,0]
