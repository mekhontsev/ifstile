h2=[0,1,0]
h3=[0,1,1]
h4=c*d*a*[1,0,0]
h5=c*d*a*[1,0,-1]
h6=[1,1,0]
h7=[1,1,1]

@:G
$n=2.691624_38
h0=[0,0,0]
h1=c*d*a*[0,0,-1]
h2=c*d*a*[0,-1,0]
