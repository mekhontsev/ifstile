@S
#
#3-generated self-similar sets
#
$dim=2
$camera=[0,0,1]
&r=$number($real(0,1))
&i=$number($integer(0,1))
r0=r	#scale 0
a0=r	#rotation 0
p0=i	#reflection 0
		#translation 0 = (0,0)
r1=r	#scale 1
a1=r	#rotation 1
q1=r	#translation vector 1 (angle only)
p1=i	#reflection 1
r2=r	#scale 2
a2=r	#rotation 2
q2=r	#translation vector 2 (angle only)
p2=i	#reflection 2
pi=2*asin(1)
g=2*pi
c0=r0*cos((g*a0))
s0=r0*sin((g*a0))
c1=r1*cos((g*a1))
s1=r1*sin((g*a1))
c2=r2*cos((g*a2))
s2=r2*sin((g*a2))
rf=[1,0,0,-1] #reflection
m0=[c0,-s0,s0,c0]*rf^(p0)
m1=[c1,-s1,s1,c1]*rf^(p1)
m2=[c2,-s2,s2,c2]*rf^(p2)
B1=q1*pi
B2=q2*B1+pi
f0=[(1-r0),0]*m0
f1=[((1-r1)*cos(B1)),((1-r1)*sin(B1))]*m1
f2=[((1-r2)*cos(B2)),((1-r2)*sin(B2))]*m2
A=(f0|f1|f2)*A

@:S
$a=c
$n=keyframe 0
r0=0.5
a0=0
p0=0
r1=0.5
a1=0
q1=0.6666666666666666
p1=0
r2=0.5
a2=0
q2=0.5
p2=0

@:S
$a=c
$n=keyframe 1
r0=0.5
a0=0.16666666666666666
p0=0
r1=0.5
a1=0.16666666666666666
q1=0.6666666666666666
p1=0
r2=0.5
a2=0.16666666666666666
q2=0.5
p2=0
