//AIFS_IGNORE_BEGIN

export const $info = `
**Algebraic self-affine trees.**
`

let params = [
	["Maps in the trunk",
		[7n, 2, 20]],
	["Maps in the branches",
		[0n, 0, 100]],
	["Max algebraic dimension",
		[2n, 1, 8]],
	["Palindromic",
		[0n, 0, 1]],
	["Maximum coefficient of a polynomial",
		[3n, 1, 10]],
	["Maximum used order of the group generator: s^E, s^-E",
		[3n, 1, 15]],
	["Max numerator (for irrational search only)",
		[1n, 1, 10]],
	["Max denominator (for irrational search only)",
		[1n, 1, 10]],
]

function create() {

	const [N, B, D, P, C, E, R, Q] = this;

	let dim = D;

	let z = [];
	let pn = dim;
	if (P == 1) {
		if (dim % 2 != 0) {
			dim = dim - 1;
		}
		pn = dim / 2;
		z.push(1);
		for (let i = 1; i < dim; ++i) {
			if (i <= pn) {
				z.push(`p[${i - 1}]/a`);
			} else {
				z.push(`p[${dim - i - 1}]/a`);
			}
		}
	} else {
		for (let i = 0; i < dim; ++i) {
			z.push(`p[${i}]/a`);
		}
	}

	let v = [1]
	for (let i = 1; i < dim; ++i) {
		v.push(0)
	}

	let max_j = (P == 0 && dim > 2) ? 1 : 3

	let M = N + B; //total number of maps

	let T = {
		$id: `G${N}_${B}_${dim}_${P}`,
		$dim: dim,
		$subspace: "[c,i]",
		z: z,
		c: "$companion(z)",
		x: "$exchange()",
		v: v,
		w: `x*c^${dim - 1}`,
		xj: "[1,(v*-1),w,(w*v*-1)]",
		p: `$vector(${pn},$integer(${ - C},${C}))`,
		k: `$vector(${M},$integer(${ - E},${E}))`,
		r: `$vector(${M},$integer(${ - R},${R - 1}))`,
		q: `$vector(${M},$integer(1,${Q}))`,
		j: `$vector(${M},$integer(0,${max_j}))`,
		a: `$number($integer(1,${C}))`,
		i: `$number($integer(0,${dim - 1}))`,
		u: "v*0",
	}
	if (B>0){
		T.b = `$vector(${B},$integer(0,${M - 1}))`
	}

	let s = "["
		for (let i = 0; i < M; ++i) {
			if (i > 0)
				s += ","
				s += `(r[${i}]+if(r[${i}]+1,1,0))/q[${i}]*c^k[${i}]`;
		}
		s += "]"
		T.s = s;

	let y = "["
		for (let i = 0; i < M; ++i) {
			if (i > 0)
				y += ","
				y += i < N ? i : `b[${i - N}] % ${i + 1}`
		}
		y += "]"
		T.y = y;

	let t = "["
		for (let i = 0; i < M; ++i) {
			if (i > 0)
				t += ","
				t += `if (y[${i}], (s[y[${i}] - 1]*u+1)*t[y[${i}] - 1], 1)`
		}
		t += "]"
		T.t = t;

	let sum = "";
	for (let i = 0; i < N; ++i) {
		if (i > 0) {
			sum = sum + "+";
		}
		sum = sum + `s[${i}]`;
	}
	T.g = sum;

	let uni = "";
	for (let i = 0; i < M; ++i) {
		T["h" + i] = `t[${i}]*s[${i}]*xj[j[${i}]]`;

		if (i > 0) {
			uni = uni + "|";
		}
		uni = uni + "h" + i;
	}
	T.A = "g^-1*(" + uni + ")*A";

	return T
}

export const $constructor = [create, params];

//AIFS_IGNORE_END
