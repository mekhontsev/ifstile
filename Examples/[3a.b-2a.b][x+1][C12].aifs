h0=Q
h1=Q
h2=Q
h3=Q
h4=Q
h5=Q
h6=Q
A0=g^-1*h0*A0|g^-1*h1*A0|g^-1*h2*A0|g^-1*h3*A1
A1=g^-1*h4*A0|g^-1*h5*A0|g^-1*h6*A1

