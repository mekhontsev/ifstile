@scale3d
$a=h
kx=1
ky=1
kz=1
ret=[kx,0,0,0,ky,0,0,0,kz]

@rotate3d
$a=h
q=[0,0,1]
ang=0
k1=1
k2=1
arad=ang*asin(1)/90
sn=k2*sin(arad)
cs=k2*cos(arad)
qn=(q[0]*q[0]+q[1]*q[1]+q[2]*q[2])^(1/2)
x=q[0]/qn
y=q[1]/qn
z=q[2]/qn
a=[(x*x),(x*y),(x*z),(y*x),(y*y),(y*z),(z*x),(z*y),(z*z)]
b=[0,z,-y,-z,0,x,y,-x,0]
ret=k1*a-(b*sn)-((a-1)*cs)


@TreeBase
$a=h
$dim=3
$camera=[[0,0.5,-2.5],[0,0.5,0],[0,1,0],30]
a=$number($real(0,1))
b=$number($real(0,1))
c=$number($real(-1,1))
d=$number($real(-1,1))
e=$number($real(0,1))
f=$number($real(0,1))
f1=scale3d(b,a,b)
f2=[0,1,0]*rotate3d([0,1,0],144)*scale3d(c,e,c)*[0,-1,0]
f3=[0,f,0]*d*rotate3d([0,0,1],60)
S=(f1|f2|f3)*S

@:TreeBase
$n=Tree1
a=0.2
b=0.1
c=0.9
d=0.3
e=0.8
f=0.2

@:TreeBase
$n=Tree2
a=0.2
b=0.1
c=0.9
d=0.3
e=0.9
f=0.2

@:TreeBase
$n=Tree3
a=0.1
b=0.1
c=0.95
d=0.3
e=0.94
f=0.1

@:TreeBase
$n=Tree4
a=0.1
b=0.1
c=0.9
d=0.3
e=0.95
f=0.1