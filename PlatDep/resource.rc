#include "version.h"

#ifndef DEVELOPER_VERSION
101 ICON    DISCARDABLE     "Resources/Application.ico"
#endif

#ifdef __GNUC__
1 24 "mingw.manifest"
#endif

LANGUAGE 0x09, 0x01

1 VERSIONINFO
    FILEVERSION PROJECT_VERSION_MAJOR, PROJECT_VERSION_MINOR
    PRODUCTVERSION PROJECT_VERSION_MAJOR, PROJECT_VERSION_MINOR
    FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
    FILEFLAGS 0x1L
#else
    FILEFLAGS 0x0L
#endif
    FILEOS 0x4L
    FILETYPE 0x1L
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", APPLICATION_TITLE "\0"
            VALUE "CompanyName", APPLICATION_COMPANY "\0"
            VALUE "FileDescription", APPLICATION_TITLE " Application\0"
            VALUE "FileVersion", PROJECT_VERSION "\0"
            VALUE "InternalName", APPLICATION_TITLE "\0"
            VALUE "LegalCopyright", APPLICATION_COPYRIGHT "\0"
            VALUE "OriginalFilename", APPLICATION_TITLE "\0"
            VALUE "ProductName", APPLICATION_TITLE "\0"
            VALUE "ProductVersion", PROJECT_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


